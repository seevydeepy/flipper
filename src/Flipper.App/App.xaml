<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Flipper.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="InkColor">#1B3A4B</Color>
            <Color x:Key="PaperColor">#F3E8D6</Color>
            <Color x:Key="CardColor">#FFFCF7</Color>
            <Color x:Key="GoldColor">#B8956A</Color>
            <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
            <SolidColorBrush x:Key="PaperBrush" Color="{StaticResource PaperColor}" />
            <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
            <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource GoldColor}" />
            <SolidColorBrush x:Key="GoldSoftBrush" Color="#66B8956A" />
            <SolidColorBrush x:Key="PanelBrush" Color="#F4FFF8EE" />
            <SolidColorBrush x:Key="MuteBrush" Color="#6B7C86" />
            <Style TargetType="Button" x:Key="QuietButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="10,6" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
