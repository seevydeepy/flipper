<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Flipper.App.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Flipper.App.Controls"
    xmlns:local="using:Flipper.App.Views"
    RequestedTheme="Light"
    Background="{StaticResource PaperBrush}">
    <Grid>
        <controls:ManuscriptBackdrop />
        <Grid Padding="20,20,0,20" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                x:Name="OfflineLabel"
                Text="Library offline"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="{StaticResource InkBrush}"
                Visibility="Collapsed" />

            <Grid Grid.Row="1" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Grid.RowSpan="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource GoldSoftBrush}"
                    BorderThickness="1"
                    CornerRadius="16" />

                <Grid Grid.RowSpan="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" MinHeight="76" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Image
                        x:Name="WordmarkImage"
                        Margin="10,8"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Stretch="Uniform"
                        IsHitTestVisible="False"
                        AutomationProperties.Name="Carousel" />
                    <Grid Grid.Row="1" Padding="14,22,14,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button
                            x:Name="AddPlaylistButton"
                            Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,12"
                            Click="AddPlaylist_Click"
                            AutomationProperties.Name="Add Playlist">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="16" Foreground="{StaticResource InkBrush}" />
                                <TextBlock Text="Add Playlist" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Grid x:Name="PlaylistDeleteHost" Grid.Row="1" Margin="0,0,0,8">
                            <TreeView
                                x:Name="FolderTree"
                                SelectionMode="Single"
                                ItemInvoked="FolderTree_ItemInvoked"
                                Expanding="FolderTree_Expanding"
                                Collapsed="FolderTree_Collapsed"
                                IsHoldingEnabled="True"
                                Holding="FolderTree_Holding"
                                RightTapped="FolderTree_RightTapped"
                                AllowDrop="True"
                                DragOver="FolderTree_DragOver"
                                Drop="FolderTree_Drop">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="MinHeight" Value="48" />
                                        <Setter Property="Padding" Value="8,10" />
                                        <Setter Property="FontSize" Value="16" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <DataTemplate x:DataType="TreeViewNode">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock
                                                Text="{x:Bind local:FolderMark.GlyphOf(Content)}"
                                                Visibility="{x:Bind local:FolderMark.GlyphVisibility(Content)}"
                                                FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                                FontSize="18"
                                                FontWeight="Normal"
                                                VerticalAlignment="Center"
                                                AutomationProperties.AccessibilityView="Raw" />
                                            <TextBlock
                                                Text="{x:Bind local:FolderMark.NameOf(Content)}"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                            <Button
                                x:Name="DeletePlaylistButton"
                                Style="{StaticResource QuietButton}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Padding="4"
                                MinWidth="44"
                                MinHeight="44"
                                Visibility="Collapsed"
                                Click="DeletePlaylist_Click"
                                AutomationProperties.Name="Delete playlist">
                                <FontIcon Glyph="&#xE74D;" FontSize="18" />
                            </Button>
                        </Grid>
                        <Button
                            x:Name="SettingsButton"
                            Grid.Row="2"
                            Style="{StaticResource PlainButton}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            VerticalAlignment="Bottom"
                            Padding="12,10"
                            Click="Settings_Click"
                            AutomationProperties.Name="Settings">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE713;" FontSize="20" Foreground="{StaticResource InkBrush}" />
                                <TextBlock Text="Settings" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>

                <Grid
                    x:Name="ScoreHeaderHost"
                    Grid.Column="1"
                    Padding="0,14"
                    VerticalAlignment="Center"
                    SizeChanged="ScoreColumn_SizeChanged">
                    <Grid
                        x:Name="ScoreHeader"
                        HorizontalAlignment="Left"
                        ColumnSpacing="12"
                        Padding="8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="SearchBox" Style="{StaticResource AppTextBox}" PlaceholderText="Search" VerticalAlignment="Center" TextChanged="SearchBox_TextChanged" />
                        <ComboBox x:Name="SortBox" Grid.Column="1" Style="{StaticResource AppComboBox}" MinWidth="148" HorizontalAlignment="Stretch" VerticalAlignment="Center" SelectionChanged="SortBox_SelectionChanged">
                            <ComboBoxItem Content="A–Z" Tag="Name" />
                            <ComboBoxItem Content="Recent" Tag="Recent" />
                            <ComboBoxItem Content="Most played" Tag="MostPlayed" />
                        </ComboBox>
                        <Button x:Name="SortDirectionButton" Grid.Column="2" Style="{StaticResource SecondaryButton}" Width="48" Padding="0" VerticalAlignment="Center" Click="SortDirection_Click" AutomationProperties.Name="Reverse sort">
                            <FontIcon x:Name="SortDirectionIcon" Glyph="&#xE74B;" FontSize="18" Foreground="{StaticResource InkBrush}" />
                        </Button>
                    </Grid>
                </Grid>

                <Grid x:Name="ScoreColumn" Grid.Row="1" Grid.Column="1" SizeChanged="ScoreColumn_SizeChanged">
                    <Grid
                        x:Name="ScoreContent"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch">
                        <GridView
                            x:Name="ScoreGrid"
                            Padding="0"
                            Background="Transparent"
                            IsItemClickEnabled="True"
                            ItemClick="ScoreGrid_ItemClick"
                            CanDragItems="True"
                            DragItemsStarting="ScoreGrid_DragItemsStarting"
                            DragItemsCompleted="ScoreGrid_DragItemsCompleted"
                            SelectionMode="None"
                            ContainerContentChanging="ScoreGrid_ContainerContentChanging">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" CacheLength="1" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="Margin" Value="8" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinWidth" Value="0" />
                                    <Setter Property="Width" Value="176" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </Style>
                            </GridView.ItemContainerStyle>
                            <GridView.ItemContainerTransitions>
                                <TransitionCollection />
                            </GridView.ItemContainerTransitions>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="local:ScoreCard">
                                    <Grid
                                        Width="176"
                                        Height="272"
                                        Padding="8"
                                        Background="{StaticResource CardBrush}"
                                        BorderBrush="{StaticResource GoldSoftBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        IsHoldingEnabled="True"
                                        Holding="ScoreCard_Holding"
                                        RightTapped="ScoreCard_RightTapped"
                                        Tapped="ScoreCard_Tapped"
                                        Tag="{x:Bind}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Background="#E8E0D4" CornerRadius="8" Margin="0,0,0,8">
                                            <Grid>
                                                <Image Source="{x:Bind Preview, Mode=OneWay}" Stretch="UniformToFill" />
                                                <Button
                                                    Style="{StaticResource RoundButton}"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="4"
                                                    Click="Favourite_Click"
                                                    Tag="{x:Bind}"
                                                    Visibility="{x:Bind FavouriteVisibility}"
                                                    AutomationProperties.Name="Favourite">
                                                    <FontIcon
                                                        Glyph="{x:Bind StarGlyph, Mode=OneWay}"
                                                        Foreground="{x:Bind StarBrush, Mode=OneWay}"
                                                        FontSize="20" />
                                                </Button>
                                                <Button
                                                    Style="{StaticResource RoundButton}"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Bottom"
                                                    Margin="4"
                                                    Click="EditScore_Click"
                                                    Tag="{x:Bind}"
                                                    Visibility="{x:Bind FavouriteVisibility}"
                                                    AutomationProperties.Name="Edit score details"
                                                    ToolTipService.ToolTip="Edit score details">
                                                    <FontIcon Glyph="&#xE70F;" FontSize="18" Foreground="{StaticResource InkBrush}" />
                                                </Button>
                                                <Button
                                                    Style="{StaticResource RoundButton}"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Bottom"
                                                    Margin="4"
                                                    Click="Restore_Click"
                                                    Tag="{x:Bind}"
                                                    Visibility="{x:Bind RestoreVisibility}"
                                                    AutomationProperties.Name="Restore">
                                                    <FontIcon
                                                        Glyph="&#xE10E;"
                                                        Foreground="{StaticResource InkBrush}"
                                                        FontSize="18" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Row="1" Spacing="2" Margin="2,0">
                                            <controls:ScrollingText
                                                Text="{x:Bind Title, Mode=OneWay}"
                                                IsActive="{x:Bind IsHighlighted, Mode=OneWay}"
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource InkBrush}" />
                                            <controls:ScrollingText
                                                Text="{x:Bind Subtitle, Mode=OneWay}"
                                                IsActive="{x:Bind IsHighlighted, Mode=OneWay}"
                                                FontSize="14"
                                                Foreground="{StaticResource MuteBrush}"
                                                Visibility="{x:Bind SubtitleVisibility, Mode=OneWay}" />
                                            <controls:ScrollingText
                                                Text="{x:Bind Composer, Mode=OneWay}"
                                                IsActive="{x:Bind IsHighlighted, Mode=OneWay}"
                                                FontSize="14"
                                                Foreground="{StaticResource MuteBrush}"
                                                Visibility="{x:Bind ComposerVisibility, Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </Grid>
                </Grid>
            </Grid>

            <TextBlock
                x:Name="ErrorLabel"
                Grid.Row="2"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="{StaticResource InkBrush}"
                Visibility="Collapsed" />
        </Grid>
        <Grid
            x:Name="TrashDrop"
            HorizontalAlignment="Left"
            Width="60"
            Margin="0,24,0,24"
            AllowDrop="True"
            Visibility="Collapsed"
            DragOver="TrashDrop_DragOver"
            Drop="TrashDrop_Drop"
            AutomationProperties.Name="Trash">
            <Rectangle
                x:Name="TrashDropFill"
                RadiusX="12"
                RadiusY="12"
                Fill="#F5C6C6"
                Stroke="#C62828"
                StrokeThickness="2"
                StrokeDashArray="6,4" />
            <Viewbox
                x:Name="TrashDropDeleteIcon"
                MaxWidth="24"
                MaxHeight="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Path
                    Width="24"
                    Height="24"
                    Fill="#C62828"
                    Data="M9,3 H15 L16,5 H21 V7 H3 V5 H8 Z M6,8 H18 L16.8,22 H7.2 Z" />
            </Viewbox>
            <Viewbox
                x:Name="TrashDropRestoreIcon"
                MaxWidth="24"
                MaxHeight="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed">
                <FontIcon
                    Glyph="&#xE10E;"
                    FontSize="20"
                    Foreground="#2E7D32" />
            </Viewbox>
        </Grid>
        <Grid
            x:Name="PlayDrop"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            AllowDrop="True"
            Visibility="Collapsed"
            DragOver="PlayDrop_DragOver"
            Drop="PlayDrop_Drop"
            AutomationProperties.Name="Play">
            <Rectangle
                x:Name="PlayDropFill"
                RadiusX="12"
                RadiusY="12"
                Fill="#C6F5C6"
                Stroke="#2E7D32"
                StrokeThickness="2"
                StrokeDashArray="6,4" />
            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <Viewbox
                    MaxWidth="32"
                    MaxHeight="32"
                    VerticalAlignment="Center">
                    <Path
                        Width="24"
                        Height="24"
                        Fill="#2E7D32"
                        Data="M8,5 L19,12 L8,19 Z" />
                </Viewbox>
                <TextBlock
                    Text="Play"
                    FontSize="24"
                    Foreground="#2E7D32"
                    VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <Grid
            x:Name="SelectionShade"
            Background="Transparent"
            Visibility="Collapsed"
            Tapped="SelectionShade_Tapped"
            RightTapped="SelectionShade_RightTapped"
            SizeChanged="SelectionShade_SizeChanged">
            <Path
                x:Name="SelectionShadePath"
                Fill="#33000000"
                IsHitTestVisible="False" />
        </Grid>
    </Grid>
</Page>
