<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Flipper.App.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Flipper.App.Views"
    Background="{ThemeResource LayerFillColorDefaultBrush}">
    <Grid Padding="20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="OfflineLabel" Text="Library offline" Visibility="Collapsed" />

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Flipper" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,12" />
                <TreeView
                    x:Name="FolderTree"
                    Grid.Row="1"
                    SelectionMode="Single"
                    ItemInvoked="FolderTree_ItemInvoked" />
                <Button
                    x:Name="ChooseFolderButton"
                    Grid.Row="2"
                    Content="Choose Folder"
                    HorizontalAlignment="Stretch"
                    Margin="0,12,0,0"
                    Click="ChooseFolder_Click" />
            </Grid>

            <Grid x:Name="ScoreColumn" Grid.Column="1" SizeChanged="ScoreColumn_SizeChanged">
                <Grid
                    x:Name="ScoreContent"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="12" Padding="8,0,8,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" PlaceholderText="Search" TextChanged="SearchBox_TextChanged" />
                        <ComboBox x:Name="SortBox" Grid.Column="1" MinWidth="160" SelectionChanged="SortBox_SelectionChanged">
                            <ComboBoxItem Content="A–Z" Tag="Name" />
                            <ComboBoxItem Content="Recent" Tag="Recent" />
                            <ComboBoxItem Content="Most played" Tag="MostPlayed" />
                        </ComboBox>
                        <Button x:Name="SortDirectionButton" Grid.Column="2" Click="SortDirection_Click" AutomationProperties.Name="Reverse sort">
                            <FontIcon x:Name="SortDirectionIcon" Glyph="&#xE74B;" FontSize="16" />
                        </Button>
                    </Grid>
                    <GridView
                        x:Name="ScoreGrid"
                        Grid.Row="1"
                        Padding="0"
                        IsItemClickEnabled="True"
                        ItemClick="ScoreGrid_ItemClick"
                        SelectionMode="None"
                        ContainerContentChanging="ScoreGrid_ContainerContentChanging">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" CacheLength="1" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Margin" Value="8" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="Width" Value="176" />
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemContainerTransitions>
                            <TransitionCollection />
                        </GridView.ItemContainerTransitions>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="local:ScoreCard">
                                <Grid Width="176" Height="248" Padding="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Background="#E8E0D4" CornerRadius="8" Margin="0,0,0,8">
                                        <Image Source="{x:Bind Preview, Mode=OneWay}" Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock Grid.Row="1" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                    <Grid Grid.Row="2">
                                        <TextBlock Text="{x:Bind Composer}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <Button
                                            Style="{StaticResource QuietButton}"
                                            HorizontalAlignment="Right"
                                            Click="Favourite_Click"
                                            Tag="{x:Bind}">
                                            <FontIcon
                                                Glyph="{x:Bind StarGlyph, Mode=OneWay}"
                                                Foreground="{x:Bind StarBrush, Mode=OneWay}"
                                                FontSize="16" />
                                        </Button>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Grid>
            </Grid>
        </Grid>

        <TextBlock x:Name="ErrorLabel" Grid.Row="2" Visibility="Collapsed" />
    </Grid>
</Page>
