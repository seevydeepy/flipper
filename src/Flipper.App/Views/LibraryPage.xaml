<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Flipper.App.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Flipper.App.Controls"
    xmlns:local="using:Flipper.App.Views"
    RequestedTheme="Light"
    Background="{StaticResource PaperBrush}">
    <Grid>
        <controls:ManuscriptBackdrop />
        <Grid Padding="20" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                x:Name="OfflineLabel"
                Text="Library offline"
                Foreground="{StaticResource InkBrush}"
                Visibility="Collapsed" />

            <Grid Grid.Row="1" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource GoldSoftBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Text="𝄞"
                                    FontFamily="Segoe UI Symbol"
                                    FontSize="40"
                                    Foreground="{StaticResource GoldBrush}"
                                    VerticalAlignment="Center"
                                    Margin="0,6,10,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        Text="Flipper"
                                        FontFamily="Cambria"
                                        FontSize="32"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource InkBrush}" />
                                    <Grid Height="16" Margin="0,6,20,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Rectangle Grid.Row="0" Height="1" Fill="{StaticResource GoldSoftBrush}" VerticalAlignment="Center" />
                                        <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource GoldSoftBrush}" VerticalAlignment="Center" />
                                        <Rectangle Grid.Row="2" Height="1.4" Fill="{StaticResource GoldBrush}" VerticalAlignment="Center" Opacity="0.7" />
                                        <Rectangle Grid.Row="3" Height="1" Fill="{StaticResource GoldSoftBrush}" VerticalAlignment="Center" />
                                        <Rectangle Grid.Row="4" Height="1" Fill="{StaticResource GoldSoftBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <TreeView
                            x:Name="FolderTree"
                            Grid.Row="1"
                            SelectionMode="Single"
                            ItemInvoked="FolderTree_ItemInvoked" />
                        <Button
                            x:Name="ChooseFolderButton"
                            Grid.Row="2"
                            Content="Choose Folder"
                            HorizontalAlignment="Stretch"
                            Margin="0,12,0,0"
                            Click="ChooseFolder_Click" />
                    </Grid>
                </Border>

                <Grid x:Name="ScoreColumn" Grid.Column="1" SizeChanged="ScoreColumn_SizeChanged">
                    <Grid
                        x:Name="ScoreContent"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="12" Padding="8,0,8,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SearchBox" PlaceholderText="Search" TextChanged="SearchBox_TextChanged" />
                            <ComboBox x:Name="SortBox" Grid.Column="1" MinWidth="160" SelectionChanged="SortBox_SelectionChanged">
                                <ComboBoxItem Content="A–Z" Tag="Name" />
                                <ComboBoxItem Content="Recent" Tag="Recent" />
                                <ComboBoxItem Content="Most played" Tag="MostPlayed" />
                            </ComboBox>
                            <Button x:Name="SortDirectionButton" Grid.Column="2" Click="SortDirection_Click" AutomationProperties.Name="Reverse sort">
                                <FontIcon x:Name="SortDirectionIcon" Glyph="&#xE74B;" FontSize="16" />
                            </Button>
                        </Grid>
                        <GridView
                            x:Name="ScoreGrid"
                            Grid.Row="1"
                            Padding="0"
                            Background="Transparent"
                            IsItemClickEnabled="True"
                            ItemClick="ScoreGrid_ItemClick"
                            SelectionMode="None"
                            ContainerContentChanging="ScoreGrid_ContainerContentChanging">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" CacheLength="1" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="Margin" Value="8" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinWidth" Value="0" />
                                    <Setter Property="Width" Value="176" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </Style>
                            </GridView.ItemContainerStyle>
                            <GridView.ItemContainerTransitions>
                                <TransitionCollection />
                            </GridView.ItemContainerTransitions>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="local:ScoreCard">
                                    <Grid
                                        Width="176"
                                        Height="248"
                                        Padding="8"
                                        Background="{StaticResource CardBrush}"
                                        BorderBrush="{StaticResource GoldSoftBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Background="#E8E0D4" CornerRadius="8" Margin="0,0,0,8">
                                            <Image Source="{x:Bind Preview, Mode=OneWay}" Stretch="UniformToFill" />
                                        </Border>
                                        <Grid Grid.Row="1" ColumnSpacing="4" RowSpacing="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <controls:ScrollingText
                                                Text="{x:Bind Title, Mode=OneWay}"
                                                Foreground="{StaticResource InkBrush}"
                                                VerticalAlignment="Center" />
                                            <controls:ScrollingText
                                                Grid.Row="1"
                                                Text="{x:Bind Composer, Mode=OneWay}"
                                                Foreground="{StaticResource MuteBrush}"
                                                VerticalAlignment="Center" />
                                            <Button
                                                Grid.Column="1"
                                                Grid.RowSpan="2"
                                                Style="{StaticResource QuietButton}"
                                                Padding="4"
                                                MinWidth="32"
                                                MinHeight="32"
                                                VerticalAlignment="Center"
                                                Click="Favourite_Click"
                                                Tag="{x:Bind}"
                                                AutomationProperties.Name="Favourite">
                                                <FontIcon
                                                    Glyph="{x:Bind StarGlyph, Mode=OneWay}"
                                                    Foreground="{x:Bind StarBrush, Mode=OneWay}"
                                                    FontSize="16" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </Grid>
                </Grid>
            </Grid>

            <TextBlock
                x:Name="ErrorLabel"
                Grid.Row="2"
                Foreground="{StaticResource InkBrush}"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</Page>
