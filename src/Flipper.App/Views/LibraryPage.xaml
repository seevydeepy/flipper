<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Flipper.App.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Flipper.App.Controls"
    xmlns:local="using:Flipper.App.Views"
    RequestedTheme="Light"
    Background="{StaticResource PaperBrush}">
    <Grid>
        <controls:ManuscriptBackdrop />
        <Grid Padding="20,20,0,20" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                x:Name="OfflineLabel"
                Text="Library offline"
                Foreground="{StaticResource InkBrush}"
                Visibility="Collapsed" />

            <Grid Grid.Row="1" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Grid.RowSpan="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource GoldSoftBrush}"
                    BorderThickness="1"
                    CornerRadius="16" />

                <Grid
                    Padding="14"
                    VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="𝄞"
                        FontFamily="Segoe UI Symbol"
                        FontSize="40"
                        Foreground="{StaticResource GoldBrush}"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Carousel"
                        FontFamily="Cambria"
                        FontSize="32"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource InkBrush}"
                        VerticalAlignment="Center" />
                    <Canvas
                        Grid.Column="1"
                        Height="0"
                        VerticalAlignment="Bottom"
                        Margin="0,0,20,0">
                        <Grid Canvas.Top="6" Width="170" Height="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Rectangle Grid.Row="0" Height="1" Fill="{StaticResource GoldSoftBrush}" VerticalAlignment="Center" />
                            <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource GoldSoftBrush}" VerticalAlignment="Center" />
                            <Rectangle Grid.Row="2" Height="1.4" Fill="{StaticResource GoldBrush}" VerticalAlignment="Center" Opacity="0.7" />
                            <Rectangle Grid.Row="3" Height="1" Fill="{StaticResource GoldSoftBrush}" VerticalAlignment="Center" />
                            <Rectangle Grid.Row="4" Height="1" Fill="{StaticResource GoldSoftBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Canvas>
                </Grid>

                <Grid
                    x:Name="ScoreHeaderHost"
                    Grid.Column="1"
                    Padding="0,14"
                    VerticalAlignment="Center"
                    SizeChanged="ScoreColumn_SizeChanged">
                    <Grid
                        x:Name="ScoreHeader"
                        HorizontalAlignment="Left"
                        ColumnSpacing="12"
                        Padding="8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" PlaceholderText="Search" VerticalAlignment="Center" TextChanged="SearchBox_TextChanged" />
                        <ComboBox x:Name="SortBox" Grid.Column="1" MinWidth="160" VerticalAlignment="Center" SelectionChanged="SortBox_SelectionChanged">
                            <ComboBoxItem Content="A–Z" Tag="Name" />
                            <ComboBoxItem Content="Recent" Tag="Recent" />
                            <ComboBoxItem Content="Most played" Tag="MostPlayed" />
                        </ComboBox>
                        <Button x:Name="SortDirectionButton" Grid.Column="2" VerticalAlignment="Center" Click="SortDirection_Click" AutomationProperties.Name="Reverse sort">
                            <FontIcon x:Name="SortDirectionIcon" Glyph="&#xE74B;" FontSize="16" />
                        </Button>
                    </Grid>
                </Grid>

                <Grid Grid.Row="1" Padding="14,22,14,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button
                        x:Name="AddPlaylistButton"
                        Content="Add Playlist"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,12"
                        Click="AddPlaylist_Click" />
                    <Grid x:Name="PlaylistDeleteHost" Grid.Row="1" Margin="0,0,0,8">
                        <TreeView
                            x:Name="FolderTree"
                            SelectionMode="Single"
                            ItemInvoked="FolderTree_ItemInvoked"
                            Expanding="FolderTree_Expanding"
                            Collapsed="FolderTree_Collapsed"
                            IsHoldingEnabled="True"
                            Holding="FolderTree_Holding"
                            RightTapped="FolderTree_RightTapped"
                            AllowDrop="True"
                            DragOver="FolderTree_DragOver"
                            Drop="FolderTree_Drop">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="MinHeight" Value="48" />
                                    <Setter Property="Padding" Value="8,10" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>
                        <Button
                            x:Name="DeletePlaylistButton"
                            Style="{StaticResource QuietButton}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Padding="4"
                            MinWidth="32"
                            MinHeight="32"
                            Visibility="Collapsed"
                            Click="DeletePlaylist_Click"
                            AutomationProperties.Name="Delete playlist">
                            <FontIcon Glyph="&#xE74D;" FontSize="16" />
                        </Button>
                    </Grid>
                    <Button
                        x:Name="SettingsButton"
                        Grid.Row="2"
                        Style="{StaticResource QuietButton}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Padding="8"
                        MinWidth="40"
                        MinHeight="40"
                        Click="Settings_Click"
                        AutomationProperties.Name="Settings">
                        <FontIcon Glyph="&#xE713;" FontSize="18" Foreground="{StaticResource InkBrush}" />
                    </Button>
                </Grid>

                <Grid x:Name="ScoreColumn" Grid.Row="1" Grid.Column="1" SizeChanged="ScoreColumn_SizeChanged">
                    <Grid
                        x:Name="ScoreContent"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch">
                        <GridView
                            x:Name="ScoreGrid"
                            Padding="0"
                            Background="Transparent"
                            IsItemClickEnabled="True"
                            ItemClick="ScoreGrid_ItemClick"
                            CanDragItems="True"
                            DragItemsStarting="ScoreGrid_DragItemsStarting"
                            DragItemsCompleted="ScoreGrid_DragItemsCompleted"
                            SelectionMode="None"
                            ContainerContentChanging="ScoreGrid_ContainerContentChanging">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" CacheLength="1" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="Margin" Value="8" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinWidth" Value="0" />
                                    <Setter Property="Width" Value="176" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </Style>
                            </GridView.ItemContainerStyle>
                            <GridView.ItemContainerTransitions>
                                <TransitionCollection />
                            </GridView.ItemContainerTransitions>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="local:ScoreCard">
                                    <Grid
                                        Width="176"
                                        Height="248"
                                        Padding="8"
                                        Background="{StaticResource CardBrush}"
                                        BorderBrush="{StaticResource GoldSoftBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        IsHoldingEnabled="True"
                                        Holding="ScoreCard_Holding"
                                        RightTapped="ScoreCard_RightTapped"
                                        Tapped="ScoreCard_Tapped"
                                        Tag="{x:Bind}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Background="#E8E0D4" CornerRadius="8" Margin="0,0,0,8">
                                            <Image Source="{x:Bind Preview, Mode=OneWay}" Stretch="UniformToFill" />
                                        </Border>
                                        <Grid Grid.Row="1" ColumnSpacing="4" RowSpacing="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <controls:ScrollingText
                                                Text="{x:Bind Title, Mode=OneWay}"
                                                Foreground="{StaticResource InkBrush}"
                                                VerticalAlignment="Center" />
                                            <controls:ScrollingText
                                                Grid.Row="1"
                                                Text="{x:Bind Composer, Mode=OneWay}"
                                                Foreground="{StaticResource MuteBrush}"
                                                VerticalAlignment="Center" />
                                            <Button
                                                Grid.Column="1"
                                                Grid.RowSpan="2"
                                                Style="{StaticResource QuietButton}"
                                                Padding="4"
                                                MinWidth="32"
                                                MinHeight="32"
                                                VerticalAlignment="Center"
                                                Click="Favourite_Click"
                                                Tag="{x:Bind}"
                                                Visibility="{x:Bind FavouriteVisibility}"
                                                AutomationProperties.Name="Favourite">
                                                <FontIcon
                                                    Glyph="{x:Bind StarGlyph, Mode=OneWay}"
                                                    Foreground="{x:Bind StarBrush, Mode=OneWay}"
                                                    FontSize="16" />
                                            </Button>
                                            <Button
                                                Grid.Column="1"
                                                Grid.RowSpan="2"
                                                Style="{StaticResource QuietButton}"
                                                Padding="4"
                                                MinWidth="32"
                                                MinHeight="32"
                                                VerticalAlignment="Center"
                                                Click="Restore_Click"
                                                Tag="{x:Bind}"
                                                Visibility="{x:Bind RestoreVisibility}"
                                                AutomationProperties.Name="Restore">
                                                <FontIcon
                                                    Glyph="&#xE10E;"
                                                    Foreground="{StaticResource InkBrush}"
                                                    FontSize="16" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </Grid>
                </Grid>
            </Grid>

            <TextBlock
                x:Name="ErrorLabel"
                Grid.Row="2"
                Foreground="{StaticResource InkBrush}"
                Visibility="Collapsed" />
        </Grid>
        <Grid
            x:Name="TrashDrop"
            HorizontalAlignment="Left"
            Width="60"
            AllowDrop="True"
            Visibility="Collapsed"
            DragOver="TrashDrop_DragOver"
            Drop="TrashDrop_Drop"
            AutomationProperties.Name="Trash">
            <Rectangle
                x:Name="TrashDropFill"
                Fill="#F5C6C6"
                Stroke="#C62828"
                StrokeThickness="2"
                StrokeDashArray="6,4" />
            <Viewbox
                x:Name="TrashDropDeleteIcon"
                MaxWidth="24"
                MaxHeight="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Path
                    Width="24"
                    Height="24"
                    Fill="#C62828"
                    Data="M9,3 H15 L16,5 H21 V7 H3 V5 H8 Z M6,8 H18 L16.8,22 H7.2 Z" />
            </Viewbox>
            <Viewbox
                x:Name="TrashDropRestoreIcon"
                MaxWidth="24"
                MaxHeight="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed">
                <FontIcon
                    Glyph="&#xE10E;"
                    FontSize="20"
                    Foreground="#2E7D32" />
            </Viewbox>
        </Grid>
        <Grid
            x:Name="SelectionShade"
            Background="Transparent"
            Visibility="Collapsed"
            Tapped="SelectionShade_Tapped"
            RightTapped="SelectionShade_RightTapped"
            SizeChanged="SelectionShade_SizeChanged">
            <Path
                x:Name="SelectionShadeSoft"
                Fill="#33000000"
                IsHitTestVisible="False" />
            <Path
                x:Name="SelectionShadeMid"
                Fill="#33000000"
                IsHitTestVisible="False" />
            <Path
                x:Name="SelectionShadePath"
                Fill="#33000000"
                IsHitTestVisible="False" />
        </Grid>
    </Grid>
</Page>
