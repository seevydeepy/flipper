<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Flipper.App.Views.ReaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Black"
    IsTabStop="True"
    KeyDown="ReaderPage_KeyDown">
    <Grid x:Name="ReaderRoot" Background="Black"
          IsTabStop="True"
          SizeChanged="ReaderRoot_SizeChanged"
          KeyDown="ReaderRoot_KeyDown">
        <Grid x:Name="PagesGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RightColumn" Width="*" />
            </Grid.ColumnDefinitions>
            <Image x:Name="LeftImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.16" />
                </Image.OpacityTransition>
            </Image>
            <TextBlock x:Name="LeftError" Text="Cannot draw this page" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            <Image x:Name="RightImage" Grid.Column="1" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.16" />
                </Image.OpacityTransition>
            </Image>
            <TextBlock x:Name="RightError" Grid.Column="1" Text="Cannot draw this page" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        </Grid>
        <TextBlock
            x:Name="VoiceLabel"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="16"
            Foreground="#B3FFFFFF"
            FontSize="16"
            Visibility="Collapsed" />
        <Border
            x:Name="TurnLayer"
            Background="Transparent"
            ManipulationMode="TranslateX"
            PointerPressed="TurnLayer_PointerPressed"
            PointerReleased="TurnLayer_PointerReleased"
            ManipulationCompleted="TurnLayer_ManipulationCompleted" />
        <Grid x:Name="Overlay" Background="#CC000000" VerticalAlignment="Top" Padding="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border
                Background="{StaticResource PaperBrush}"
                BorderBrush="{StaticResource GoldBrush}"
                BorderThickness="1"
                CornerRadius="4"
                VerticalAlignment="Center">
                <Button
                    x:Name="BackButton"
                    Style="{StaticResource QuietButton}"
                    Click="BackButton_Click"
                    PointerReleased="BackButton_PointerReleased"
                    IsTabStop="False"
                    AllowFocusOnInteraction="False"
                    MinWidth="0"
                    MinHeight="0"
                    Padding="12,6"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource InkBrush}"
                    AutomationProperties.Name="Back">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="Back" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Border>
            <TextBlock x:Name="TitleLabel" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Margin="16,0,16,0" />
            <TextBlock x:Name="PageLabel" Grid.Column="2" Foreground="White" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Page>
