<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Flipper.App.Views.ReaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Black"
    ManipulationMode="TranslateX">
    <Grid x:Name="ReaderRoot" Background="Black"
          PointerReleased="ReaderRoot_PointerReleased"
          ManipulationCompleted="ReaderRoot_ManipulationCompleted"
          SizeChanged="ReaderRoot_SizeChanged"
          KeyDown="ReaderRoot_KeyDown">
        <Grid x:Name="PagesGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RightColumn" Width="*" />
            </Grid.ColumnDefinitions>
            <Image x:Name="LeftImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.16" />
                </Image.OpacityTransition>
            </Image>
            <TextBlock x:Name="LeftError" Text="Cannot draw this page" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            <Image x:Name="RightImage" Grid.Column="1" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.16" />
                </Image.OpacityTransition>
            </Image>
            <TextBlock x:Name="RightError" Grid.Column="1" Text="Cannot draw this page" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        </Grid>
        <Grid x:Name="Overlay" Background="#99000000" VerticalAlignment="Top" Padding="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Content="Back" Click="BackButton_Click" />
            <TextBlock x:Name="TitleLabel" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Margin="16,0,16,0" />
            <TextBlock x:Name="PageLabel" Grid.Column="2" Foreground="White" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Page>
