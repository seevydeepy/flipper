<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Flipper.App.Views.ReaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource PaperBrush}"
    IsTabStop="True"
    KeyDown="ReaderPage_KeyDown">
    <Grid x:Name="ReaderRoot" Background="{StaticResource PaperBrush}"
          IsTabStop="True"
          SizeChanged="ReaderRoot_SizeChanged"
          PointerMoved="ReaderRoot_PointerMoved"
          KeyDown="ReaderRoot_KeyDown">
        <Grid x:Name="PagesGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RightColumn" Width="*" />
            </Grid.ColumnDefinitions>
            <Image x:Name="LeftImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.16" />
                </Image.OpacityTransition>
            </Image>
            <TextBlock x:Name="LeftError" Text="Cannot draw this page" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            <Image x:Name="RightImage" Grid.Column="1" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.16" />
                </Image.OpacityTransition>
            </Image>
            <TextBlock x:Name="RightError" Grid.Column="1" Text="Cannot draw this page" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        </Grid>
        <TextBlock
            x:Name="VoiceLabel"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="16"
            Foreground="{StaticResource MuteBrush}"
            FontSize="16"
            Visibility="Collapsed" />
        <Border
            x:Name="TurnLayer"
            Background="Transparent"
            ManipulationMode="TranslateX"
            PointerPressed="TurnLayer_PointerPressed"
            PointerReleased="TurnLayer_PointerReleased"
            ManipulationCompleted="TurnLayer_ManipulationCompleted" />
        <Grid x:Name="Chrome" VerticalAlignment="Top" Padding="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button
                    x:Name="BackButton"
                    Style="{StaticResource ChipButton}"
                    Click="BackButton_Click"
                    PointerReleased="BackButton_PointerReleased"
                    IsTabStop="False"
                    AllowFocusOnInteraction="False"
                    FontSize="16"
                    FontWeight="SemiBold"
                    AutomationProperties.Name="Back">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" Foreground="{Binding Foreground, ElementName=BackButton}" />
                        <TextBlock Text="Back" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="CropButton"
                    Style="{StaticResource ChipButton}"
                    Click="CropButton_Click"
                    PointerReleased="CropButton_PointerReleased"
                    IsTabStop="False"
                    AllowFocusOnInteraction="False"
                    AutomationProperties.Name="Crop margins">
                    <FontIcon x:Name="CropIcon" Glyph="&#xE7A8;" FontSize="16" Foreground="{Binding Foreground, ElementName=CropButton}" />
                </Button>
            </StackPanel>
            <TextBlock
                x:Name="TitleLabel"
                Grid.Column="1"
                Foreground="{StaticResource InkBrush}"
                VerticalAlignment="Center"
                Margin="16,0,16,0">
                <TextBlock.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.2" />
                </TextBlock.OpacityTransition>
            </TextBlock>
            <TextBlock
                x:Name="PageLabel"
                Grid.Column="2"
                Foreground="{StaticResource InkBrush}"
                VerticalAlignment="Center">
                <TextBlock.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.2" />
                </TextBlock.OpacityTransition>
            </TextBlock>
        </Grid>
    </Grid>
</Page>
