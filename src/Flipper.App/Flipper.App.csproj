<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Flipper.App</RootNamespace>
    <AssemblyName>Carousel</AssemblyName>
    <Product>Carousel</Product>
    <AssemblyTitle>Carousel</AssemblyTitle>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(RuntimeIdentifier)' == 'win-arm64'">ARM64</Platform>
    <Platform Condition="'$(RuntimeIdentifier)' != 'win-arm64' AND ('$(Platform)' == '' OR '$(Platform)' == 'AnyCPU')">x64</Platform>
    <PlatformTarget Condition="'$(Platform)' == 'x64'">x64</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)' == 'ARM64'">ARM64</PlatformTarget>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SherpaOnnxVersion>1.13.5</SherpaOnnxVersion>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <Content Include="Assets\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\carousel-wordmark.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\kofi-support.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\kofi-support-hover.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\playlist-add.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\delete.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <EmbeddedResource Include="Assets\AppIcon.ico" />
    <Content Include="Voice\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Wink\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(PkgMicrosoft_ML_OnnxRuntime_Managed)\LICENSE.txt" Link="Wink\ONNXRUNTIME-LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(PkgMicrosoft_ML_OnnxRuntime_Managed)\ThirdPartyNotices.txt" Link="Wink\ONNXRUNTIME-NOTICES.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="$(SherpaOnnxVersion)" />
    <!-- Keep Sherpa's speech API, but use Microsoft's signed ONNX Runtime. -->
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x64" Version="$(SherpaOnnxVersion)"
                      ExcludeAssets="native" GeneratePathProperty="true" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-arm64" Version="$(SherpaOnnxVersion)"
                      ExcludeAssets="native" GeneratePathProperty="true" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.27.1" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.27.1" ExcludeAssets="build;buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(Pkgorg_k2fsa_sherpa_onnx_runtime_win-x64)\runtimes\win-x64\native\sherpa-onnx-c-api.dll"
             Condition="'$(Platform)' == 'x64'" Link="sherpa-onnx-c-api.dll"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(Pkgorg_k2fsa_sherpa_onnx_runtime_win-arm64)\runtimes\win-arm64\native\sherpa-onnx-c-api.dll"
             Condition="'$(Platform)' == 'ARM64'" Link="sherpa-onnx-c-api.dll"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Windows App SDK also carries an older ORT. Do not copy it over our matching runtime. -->
  <Target Name="ExcludeWindowsAppSdkOnnxRuntime"
          BeforeTargets="AddMicrosoftWindowsAppSDKPayloadFilesFromComponents;AddMicrosoftWindowsAppSDKPayloadFilesFromMsix"
          DependsOnTargets="GetWindowsAppSDKNativePlatform">
    <ItemGroup>
      <MicrosoftWindowsAppSDKFilesExcluded Include="$(MicrosoftWindowsAppSDKMsixContent)\onnxruntime.dll;$(MicrosoftWindowsAppSDKMsixContent)\onnxruntime_providers_shared.dll"
                                          Condition="'$(MicrosoftWindowsAppSDKMsixContent)' != ''" />
      <MicrosoftWindowsAppSDKFilesExcluded Include="@(WindowsAppSdkComponentPackages->'%(FullPath)runtimes-framework\win-$(NativePlatform)\native\onnxruntime.dll')" />
      <MicrosoftWindowsAppSDKFilesExcluded Include="@(WindowsAppSdkComponentPackages->'%(FullPath)runtimes-framework\win-$(NativePlatform)\native\onnxruntime_providers_shared.dll')" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Flipper.Core\Flipper.Core.csproj" />
  </ItemGroup>
</Project>
